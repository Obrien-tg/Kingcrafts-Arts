---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found | KING CRAFT ARTS" description="The requested KING CRAFT ARTS page could not be found.">
  <section class="shell flex min-h-[60vh] flex-col justify-center py-16 sm:py-24">
    <p class="eyebrow">404</p>
    <h1 class="mt-4 max-w-2xl font-display text-5xl font-medium tracking-tight sm:text-7xl">This page has wandered off.</h1>
    <p class="mt-6 max-w-xl text-lg leading-8 text-stone-700">
      The page you are looking for is not here. Try one of these paths instead.
    </p>
    <nav aria-label="Helpful links" class="mt-10 flex flex-wrap gap-4">
      <a href="/" class="rounded-full bg-stone-950 px-6 py-3 text-sm font-semibold text-stone-50 hover:bg-stone-700 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-amber-700">Home</a>
      <a href="/gallery/" class="rounded-full border border-stone-300 px-6 py-3 text-sm font-semibold text-stone-800 hover:border-stone-950 hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-amber-700">Gallery</a>
      <a href="/contact/" class="rounded-full border border-stone-300 px-6 py-3 text-sm font-semibold text-stone-800 hover:border-stone-950 hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-amber-700">Contact</a>
    </nav>
  </section>
</Layout>
