---
import { Image } from "astro:assets";
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { getBagWhatsAppMessage, getMadeToOrderWhatsAppMessage, getWhatsAppUrl } from "../../data/site";

export async function getStaticPaths() {
  const bags = (await getCollection("bags")).filter((bag) => bag.data.publicationStatus === "published");

  return bags.map((bag) => ({
    params: { slug: bag.id },
    props: { bag },
  }));
}

interface Props {
  bag: CollectionEntry<"bags">;
}

const { bag } = Astro.props;
const { data } = bag;
const { Content } = await render(bag);
const whatsappUrl = getWhatsAppUrl(getBagWhatsAppMessage(data.title));
const madeToOrderWhatsAppUrl = getWhatsAppUrl(getMadeToOrderWhatsAppMessage(data.title));
const availabilityLabel =
  data.availability === "unconfirmed"
    ? "Availability to be confirmed"
    : data.availability === "available"
      ? "Available"
      : "Currently unavailable";
const formatPrice = (price: number) =>
  new Intl.NumberFormat("en-ZA", { style: "currency", currency: "ZAR", maximumFractionDigits: 0 }).format(price);
---

<Layout
  title={`${data.title} | KING CRAFT ARTS`}
  description={`${data.title} by KING CRAFT ARTS. View pricing and make a custom inquiry with Ronald Takunda Chaparadza.`}
>
  <article class="shell py-12 sm:py-20">
    <a
      href="/gallery/"
      class="inline-flex rounded-full text-sm font-semibold text-stone-700 underline decoration-stone-300 underline-offset-4 hover:text-stone-950 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-amber-700"
    >
      ← Back to gallery
    </a>

    <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(20rem,0.9fr)] lg:items-start lg:gap-16">
      <div class="image-glass-frame aspect-[4/3]">
        {
          data.image ? (
            <Image
              src={data.image}
              alt={data.imageAlt || `${data.title} product image`}
              width={1280}
              height={960}
              loading="eager"
              decoding="async"
              class="h-full w-full object-cover"
            />
          ) : (
            <div class="flex h-full flex-col items-center justify-center gap-3 px-6 text-center">
              <span class="font-display text-5xl text-stone-400" aria-hidden="true">KCA</span>
              <p class="text-sm font-medium uppercase tracking-[0.16em] text-stone-600">Product image pending</p>
            </div>
          )
        }
      </div>

      <div>
        <p class="eyebrow">{data.category.replaceAll("-", " ")}</p>
        <h1 class="mt-4 font-display text-4xl font-medium tracking-tight sm:text-5xl">{data.title}</h1>
        <p class="mt-6 text-lg leading-8 text-stone-700">{data.description}</p>
        <p class="mt-4 text-xs font-semibold uppercase tracking-[0.14em] text-stone-500">{availabilityLabel}</p>

        <dl class="mt-8 grid gap-4 border-y border-stone-200 py-6">
          <div class="flex items-baseline justify-between gap-6">
            <dt class="text-sm text-stone-600">Standard Price</dt>
            <dd class="font-semibold">{formatPrice(data.standardPrice)}</dd>
          </div>
          <div class="flex items-baseline justify-between gap-6">
            <dt class="text-sm text-stone-600">Made-to-Order Price</dt>
            <dd class="font-semibold">{formatPrice(data.madeToOrderPrice)}</dd>
          </div>
        </dl>

        {
          data.materials && data.materials.length > 0 && (
            <div class="mt-8">
              <h2 class="text-sm font-semibold uppercase tracking-[0.16em] text-stone-600">Materials</h2>
              <ul class="mt-3 list-inside list-disc text-stone-700">
                {data.materials.map((material) => <li>{material}</li>)}
              </ul>
            </div>
          )
        }

        {
          data.customisationOptions && data.customisationOptions.length > 0 && (
            <div class="mt-8">
              <h2 class="text-sm font-semibold uppercase tracking-[0.16em] text-stone-600">Customisation options</h2>
              <ul class="mt-3 list-inside list-disc text-stone-700">
                {data.customisationOptions.map((option) => <li>{option}</li>)}
              </ul>
            </div>
          )
        }

        {
          data.imageStatus === "pending" && (
            <p class="mt-8 text-sm text-stone-600">Product photography pending confirmation.</p>
          )
        }

        {
          whatsappUrl && (
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noreferrer"
              class="mt-8 inline-flex min-h-12 items-center rounded-full bg-stone-950 px-6 text-sm font-semibold text-stone-50 hover:bg-stone-700 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-amber-700"
            >
              Enquire on WhatsApp
            </a>
          )
        }
        {
          madeToOrderWhatsAppUrl && (
            <a
              href={madeToOrderWhatsAppUrl}
              target="_blank"
              rel="noreferrer"
              class="mt-4 inline-flex min-h-12 items-center rounded-full border border-stone-300 px-6 text-sm font-semibold text-stone-800 hover:border-stone-950 hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-amber-700"
            >
              Ask about made-to-order
            </a>
          )
        }
      </div>
    </div>

    <div class="prose-copy mt-12 max-w-2xl border-t border-stone-200 pt-8">
      <Content />
    </div>
  </article>
</Layout>
