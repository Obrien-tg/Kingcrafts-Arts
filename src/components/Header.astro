---
import { site } from "../data/site";

const navigation = [
  { href: "/", label: "Home" },
  { href: "/gallery/", label: "Gallery" },
  { href: "/artist/", label: "Artist" },
  { href: "/custom/", label: "Custom Orders" },
  { href: "/contact/", label: "Contact" },
];
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-stone-200/80 bg-stone-50/95 backdrop-blur">
  <div class="shell flex min-h-16 items-center justify-between gap-6">
    <a
      href="/"
      class="font-display text-sm font-semibold tracking-[0.2em] text-stone-950 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-amber-700"
      aria-label={`${site.name} home`}
    >
      {site.name}
    </a>

    <button
      type="button"
      class="menu-button inline-flex min-h-11 items-center gap-2 rounded-full px-3 text-sm font-medium text-stone-800 hover:bg-stone-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700 md:hidden"
      aria-expanded="false"
      aria-controls="site-navigation"
    >
      <span class="menu-label">Menu</span>
      <span aria-hidden="true" class="menu-icon text-lg leading-none">+</span>
    </button>

    <nav id="site-navigation" aria-label="Primary navigation" class="hidden md:block">
      <ul class="flex items-center gap-8">
        {
          navigation.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  "rounded-full px-3 py-2 text-sm font-medium text-stone-700 transition-colors hover:text-stone-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700",
                  { "text-stone-950 underline decoration-amber-700 decoration-2 underline-offset-8": currentPath === item.href },
                ]}
                aria-current={currentPath === item.href ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const setupMenu = () => {
    cleanupMenu?.();

    const menuButton = document.querySelector<HTMLButtonElement>(".menu-button");
    const navigation = document.querySelector<HTMLElement>("#site-navigation");
    const menuLabel = document.querySelector<HTMLElement>(".menu-label");
    const menuIcon = document.querySelector<HTMLElement>(".menu-icon");

    if (!menuButton || !navigation || !menuLabel || !menuIcon) {
      return;
    }

    const setMenuState = (isOpen: boolean) => {
      menuButton.setAttribute("aria-expanded", String(isOpen));
      navigation.classList.toggle("hidden", !isOpen);
      navigation.classList.toggle("mobile-navigation", isOpen);
      menuLabel.textContent = isOpen ? "Close" : "Menu";
      menuIcon.textContent = isOpen ? "×" : "+";
    };

    const handleMenuClick = () => {
      setMenuState(menuButton.getAttribute("aria-expanded") !== "true");
    };

    const handleNavigationClick = (event: MouseEvent) => {
      if ((event.target as HTMLElement).closest("a")) {
        setMenuState(false);
      }
    };

    const handleKeydown = (event: KeyboardEvent) => {
      if (event.key === "Escape" && menuButton.getAttribute("aria-expanded") === "true") {
        setMenuState(false);
        menuButton.focus();
      }
    };

    menuButton.addEventListener("click", handleMenuClick);
    navigation.addEventListener("click", handleNavigationClick);
    document.addEventListener("keydown", handleKeydown);

    cleanupMenu = () => {
      menuButton.removeEventListener("click", handleMenuClick);
      navigation.removeEventListener("click", handleNavigationClick);
      document.removeEventListener("keydown", handleKeydown);
    };
  };

  let cleanupMenu: (() => void) | undefined;
  setupMenu();
  document.addEventListener("astro:page-load", setupMenu);
</script>
