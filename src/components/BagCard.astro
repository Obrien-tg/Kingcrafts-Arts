---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getBagWhatsAppMessage, getWhatsAppUrl } from "../data/site";

interface Props {
  bag: CollectionEntry<"bags">;
  priority?: boolean;
}

const { bag, priority = false } = Astro.props;
const { data } = bag;
const whatsappUrl = getWhatsAppUrl(getBagWhatsAppMessage(data.title));
const imageAlt = data.imageAlt || `${data.title} product image`;
const detailUrl = `/gallery/${bag.id}/`;
const availabilityLabel =
  data.availability === "unconfirmed"
    ? "Availability to be confirmed"
    : data.availability === "available"
      ? "Available"
      : "Currently unavailable";
const formatPrice = (price: number) =>
  new Intl.NumberFormat("en-ZA", { style: "currency", currency: "ZAR", maximumFractionDigits: 0 }).format(price);
---

<article class="flex h-full flex-col overflow-hidden rounded-2xl border border-earth/15 bg-white shadow-sm">
  <a
    href={detailUrl}
    class="group block focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-gold"
    aria-label={`View ${data.title} details`}
  >
    <div class="aspect-[4/3] overflow-hidden bg-earth/10">
      {
        data.image ? (
          <Image
            src={data.image}
            alt={imageAlt}
            width={960}
            height={720}
            loading={priority ? "eager" : "lazy"}
            decoding="async"
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
        ) : (
          <div class="relative flex h-full flex-col items-center justify-center gap-3 px-6 text-center">
            <div class="absolute inset-[18%] rounded-[45%_55%_50%_50%/55%_45%_55%_45%] border border-earth/25" aria-hidden="true"></div>
            <span class="relative font-display text-4xl text-earth/60" aria-hidden="true">KCA</span>
            <p class="relative text-sm font-semibold uppercase tracking-[0.16em] text-earth">Photograph to be added</p>
            <p class="relative text-xs text-ink/60">Style details remain available below.</p>
          </div>
        )
      }
    </div>
  </a>

  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <p class="eyebrow">{data.category.replaceAll("-", " ")}</p>
    <h2 class="mt-2 font-display text-2xl font-medium tracking-tight">
      <a href={detailUrl} class="rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold">
        {data.title}
      </a>
    </h2>
    <p class="mt-3 text-sm leading-6 text-ink/70">{data.description}</p>
    <p class="mt-4 text-xs font-semibold uppercase tracking-[0.14em] text-forest">{availabilityLabel}</p>

    <dl class="mt-6 grid gap-3 border-y border-earth/15 py-4 text-sm">
      <div class="flex items-baseline justify-between gap-4">
        <dt class="text-ink/70">Standard Price</dt>
        <dd class="font-semibold text-ink">{formatPrice(data.standardPrice)}</dd>
      </div>
      <div class="flex items-baseline justify-between gap-4">
        <dt class="text-ink/70">Made-to-Order Price</dt>
        <dd class="font-semibold text-ink">{formatPrice(data.madeToOrderPrice)}</dd>
      </div>
    </dl>

    <div class="mt-auto flex flex-wrap items-center gap-4 pt-5">
      <a
        href={detailUrl}
        class="rounded-full bg-earth px-4 py-2.5 text-sm font-semibold text-cream transition-colors hover:bg-ochre focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold"
      >
        View details
      </a>
      {
        whatsappUrl && (
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noreferrer"
            class="rounded-full px-1 py-2.5 text-sm font-semibold text-earth underline decoration-gold/60 underline-offset-4 hover:text-ochre focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold"
          >
            Enquire on WhatsApp
          </a>
        )
      }
    </div>
  </div>
</article>
