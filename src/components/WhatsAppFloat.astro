---
import { getGeneralWhatsAppMessage, getWhatsAppUrl } from "../data/site";

const whatsappUrl = getWhatsAppUrl(getGeneralWhatsAppMessage());
---

{
  whatsappUrl && (
    <a
      href={whatsappUrl}
      class="fixed bottom-5 right-5 z-30 inline-flex min-h-12 items-center rounded-full bg-forest px-5 text-sm font-semibold text-cream shadow-lg transition-transform hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold"
      target="_blank"
      rel="noreferrer"
      aria-label="Start a WhatsApp inquiry with KING CRAFT ARTS"
    >
      WhatsApp
    </a>
  )
}
