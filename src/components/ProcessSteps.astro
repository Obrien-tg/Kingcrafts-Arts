---
interface Step {
  title: string;
  description: string;
}

interface Props {
  steps: readonly Step[];
}

const { steps } = Astro.props;
---

<ol class="grid gap-8 border-t border-stone-200 pt-8 md:grid-cols-5 md:gap-6">
  {
    steps.map((step, index) => (
      <li>
        <span class="font-display text-3xl text-amber-700">{String(index + 1).padStart(2, "0")}</span>
        <h3 class="mt-4 text-lg font-semibold">{step.title}</h3>
        <p class="mt-2 leading-7 text-stone-600">{step.description}</p>
      </li>
    ))
  }
</ol>
