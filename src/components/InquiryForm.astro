---
import { site } from "../data/site";
import type { CollectionEntry } from "astro:content";

interface Props {
  bags: CollectionEntry<"bags">[];
}

const { bags } = Astro.props;
const endpoint = site.inquiryEndpoint;
const isNetlify = site.inquiryProvider.toLowerCase() === "netlify";
const formReady = Boolean(endpoint);
---

<div class="rounded-2xl border border-earth/15 bg-white p-6 shadow-sm sm:p-8">
  {
    formReady ? (
      <form
        action={endpoint}
        method="POST"
        class="grid gap-6"
        data-netlify={isNetlify ? "true" : undefined}
        data-netlify-honeypot={isNetlify ? "bot-field" : undefined}
      >
        {isNetlify && <input type="hidden" name="form-name" value="king-craft-arts-inquiry" />}
        <div class="hidden" aria-hidden="true">
          <label for="bot-field">Leave this field empty</label>
          <input id="bot-field" name="bot-field" tabindex="-1" autocomplete="off" />
        </div>

        <div class="grid gap-6 sm:grid-cols-2">
          <div class="grid gap-2">
            <label for="name" class="text-sm font-semibold">Name <span aria-hidden="true">*</span></label>
            <input id="name" name="name" type="text" required autocomplete="name" aria-describedby="name-help" class="form-control" />
            <p id="name-help" class="text-xs text-ink/60">Tell us who we are speaking with.</p>
          </div>
          <div class="grid gap-2">
            <label for="email" class="text-sm font-semibold">Email <span aria-hidden="true">*</span></label>
            <input id="email" name="email" type="email" required autocomplete="email" aria-describedby="email-help" class="form-control" />
            <p id="email-help" class="text-xs text-ink/60">We will only use this to respond to your enquiry.</p>
          </div>
        </div>

        <div class="grid gap-2">
          <label for="whatsapp" class="text-sm font-semibold">WhatsApp number <span class="font-normal text-ink/60">(optional)</span></label>
          <input id="whatsapp" name="whatsapp" type="tel" autocomplete="tel" class="form-control" />
        </div>

        <div class="grid gap-2">
          <label for="topic" class="text-sm font-semibold">Enquiry topic <span aria-hidden="true">*</span></label>
          <select id="topic" name="topic" required class="form-control">
            <option value="">Select a topic</option>
            <option value="general">General enquiry</option>
            <option value="bag">Bag enquiry</option>
            <option value="made-to-order">Made-to-order enquiry</option>
          </select>
        </div>

        <div class="grid gap-2">
          <label for="bag" class="text-sm font-semibold">Bag selection <span class="font-normal text-ink/60">(optional)</span></label>
          <select id="bag" name="bag" class="form-control">
            <option value="">No specific bag</option>
            {bags.map((bag) => <option value={bag.id}>{bag.data.title}</option>)}
          </select>
        </div>

        <div class="grid gap-2">
          <label for="message" class="text-sm font-semibold">Message <span aria-hidden="true">*</span></label>
          <textarea id="message" name="message" required rows="6" minlength="10" aria-describedby="message-help" class="form-control"></textarea>
          <p id="message-help" class="text-xs text-ink/60">Please include enough detail for a useful reply.</p>
        </div>

        <p class="text-xs leading-5 text-ink/60">
          By submitting this form, you are sharing the details needed to respond to this enquiry. A privacy policy will be linked here once the business policy is confirmed.
        </p>
        <button type="submit" class="inline-flex min-h-12 w-fit items-center rounded-full bg-earth px-6 text-sm font-semibold text-cream transition-colors hover:bg-ochre focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold">
          Send enquiry
        </button>
      </form>
    ) : (
      <div role="status" class="grid gap-4">
        <h2 class="font-display text-2xl">Enquiries are being connected.</h2>
        <p class="leading-7 text-ink/70">
          The enquiry form is not connected to a verified receiving service yet. Please return after the owner confirms the contact channel.
        </p>
      </div>
    )
  }
</div>
