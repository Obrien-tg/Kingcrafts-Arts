---
import { site } from "../data/site";
---

<footer class="border-t border-earth/20 bg-earth/5">
  <div class="shell grid gap-8 py-12 sm:grid-cols-2 sm:items-end">
    <div>
      <p class="font-display text-sm font-semibold tracking-[0.2em] text-ink">{site.name}</p>
      <p class="mt-3 max-w-sm text-sm leading-6 text-ink/70">
        Handcrafted bags expressing art through the hands of {site.artist}.
      </p>
      <p class="mt-2 text-[10px] tracking-wide text-earth/70">™ Made by Obrien-tg</p>
    </div>
    <div class="text-sm text-ink/70 sm:text-right">
      <p>{site.location}</p>
      <p class="mt-2 text-xs uppercase tracking-[0.2em]">Portfolio & custom inquiries</p>
    </div>
  </div>
</footer>
