---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "KING CRAFT ARTS",
  description = "Handcrafted bags by Ronald Takunda Chaparadza.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-stone-50 text-stone-950 antialiased">
    <slot />
  </body>
</html>
