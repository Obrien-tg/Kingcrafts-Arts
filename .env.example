# Copy this file to .env. Do not commit real credentials or contact details.

PUBLIC_SITE_URL=

# Keep empty until the owner confirms the official number.
PUBLIC_WHATSAPP_PHONE=
PUBLIC_WHATSAPP_PHONE_VERIFIED=false

# Keep empty until the owner confirms the official business email.
PUBLIC_BUSINESS_EMAIL=
PUBLIC_BUSINESS_EMAIL_VERIFIED=false

# For Netlify Forms, set the provider to netlify. No endpoint is needed:
# Netlify detects the form during deployment and stores submissions in Forms.
PUBLIC_INQUIRY_ENDPOINT=
PUBLIC_INQUIRY_PROVIDER=netlify
